---
import Layout from '../layouts/Layout.astro';

// Estrutura dos 4 cartões de tecnologia com classificação por estrelas (1 a 5)
const techCategories = [
  {
    category: 'MACHINE LEARNING & DEEP LEARNING',
    technologies: [
      { name: 'PyTorch', rating: 5 },
      { name: 'TensorFlow', rating: 4 },
      { name: 'Scikit-Learn', rating: 5 },
      { name: 'XGBoost', rating: 5 }
    ]
  },
  {
    category: 'IA GENERATIVA & LLMS',
    technologies: [
      { name: 'LangChain', rating: 4 },
      { name: 'LLamaIndex', rating: 4 },
      { name: 'Transformers', rating: 5 },
      { name: 'OpenAI / Anthropic', rating: 5 }
    ]
  },
  {
    category: 'BIG DATA & MLOPS',
    technologies: [
      { name: 'Spark', rating: 5 },
      { name: 'MLflow', rating: 4 },
      { name: 'Docker', rating: 4 },
      { name: 'Kubernetes', rating: 4 }
    ]
  },
  {
    category: 'LINGUAGENS & BANCOS',
    technologies: [
      { name: 'Python', rating: 5 },
      { name: 'SQL', rating: 5 },
      { name: 'PostgreSQL', rating: 4 },
      { name: 'Snowflake', rating: 4 }
    ]
  }
];
---

<Layout
  title="Sobre mim | Data Science Portfolio"
  description="Biografia profissional e Stack Tecnológica de Sergio Ribeiro Cerqueira"
>
  <div class="sobre-container">
    <!-- ====================================================================
         1. Seção "Sobre mim"
         ==================================================================== -->
    <section class="section-sobre" aria-labelledby="sobre-title">
      <h1 id="sobre-title" class="section-title">Sobre mim</h1>
      
      <p class="bio-text">
        Atuação sólida na intersecção entre modelagem matemática rigorosa, Machine Learning e Liderança técnica para tomada de decisões data-driven. Experiência na concepção e escala de soluções analíticas em ambientes corporativos e Fortune 500, traduzindo dados brutos em vantagem competitiva e alto retorno financeiro.
      </p>

      <!-- Cartão Horizontal de Experiência com Ícone de Certificação -->
      <div class="experience-card" role="region" aria-label="Tempo de Experiência">
        <div class="cert-icon-wrapper" aria-hidden="true">
          <svg class="cert-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
        </div>
        <div class="experience-text-group">
          <span class="experience-title">10+ Anos de Experiência</span>
          <span class="experience-subtitle">Liderança Técnica & Soluções Analíticas de Missão Crítica</span>
        </div>
      </div>

      <!-- Botões de Ação lado a lado -->
      <div class="action-buttons-group">
        <!-- Botão 1: Baixar CV Completo -->
        <a
          href="/assets/cv.pdf"
          class="btn-primary-action"
          download
          aria-label="Baixar CV Completo em PDF"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Baixar CV Completo</span>
        </a>

        <!-- Botão 2: Ver Trajetória Completa -->
        <a
          href="/experiencias"
          class="btn-secondary-action"
          aria-label="Ver Trajetória Profissional Completa"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span>Ver Trajetória Completa</span>
        </a>
      </div>
    </section>

    <!-- ====================================================================
         2. Seção "Stack Tecnológica" (Grade 2x2)
         ==================================================================== -->
    <section class="section-stack" aria-labelledby="stack-title">
      <div class="stack-header">
        <h2 id="stack-title" class="section-title">Stack Tecnológica</h2>
        <p class="stack-intro-text">
          Ferramentas, linguagens e frameworks dominados e aplicados em ambientes analíticos de missão crítica e escala produtiva.
        </p>
      </div>

      <!-- Grade 2x2 de Cartões de Tecnologia -->
      <div class="tech-grid-2x2">
        {
          techCategories.map((card) => (
            <article class="tech-card-box">
              <h3 class="tech-card-category">{card.category}</h3>
              <ul class="tech-items-list" aria-label={`Tecnologias de ${card.category}`}>
                {
                  card.technologies.map((tech) => (
                    <li class="tech-item-row">
                      <div class="tech-info-left">
                        <span class="tech-bullet-icon" aria-hidden="true">
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                            <circle cx="12" cy="12" r="8" />
                          </svg>
                        </span>
                        <span class="tech-name">{tech.name}</span>
                      </div>
                      
                      <!-- Classificação por Estrelas (Total de 5 estrelas) -->
                      <div class="stars-rating-wrapper" aria-label={`Nível ${tech.rating} de 5 estrelas`}>
                        {
                          Array.from({ length: 5 }).map((_, idx) => (
                            <svg
                              class={`star-svg ${idx < tech.rating ? 'filled' : 'empty'}`}
                              viewBox="0 0 24 24"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                            >
                              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                            </svg>
                          ))
                        }
                      </div>
                    </li>
                  ))
                }
              </ul>
            </article>
          ))
        }
      </div>

      <!-- ==================================================================
           3. Botão do GitHub Focado em Repositórios
           ================================================================== -->
      <div class="github-action-wrapper">
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-github-wide"
          aria-label="Ver Repositórios e Arquiteturas no GitHub (abre em nova aba)"
        >
          <div class="github-left-content">
            <svg class="github-logo" viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span class="github-label">Ver Repositórios &amp; Arquiteturas no GitHub</span>
          </div>
          
          <svg class="github-external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ==========================================================================
     Container Principal e Espaçamento Vertical
     ========================================================================== */
  .sobre-container {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    width: 100%;
    text-align: left;
  }

  /* ==========================================================================
     1. Seção "Sobre mim"
     ========================================================================== */
  .section-sobre {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-title {
    font-family: var(--font-title);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
  }

  .bio-text {
    font-family: var(--font-tech);
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin: 0;
  }

  /* Cartão Horizontal de Experiência */
  .experience-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background-color: var(--bg-cards);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    padding: 1.25rem 1.5rem;
    box-shadow: none;
  }

  .cert-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-lime);
    flex-shrink: 0;
  }

  .cert-icon {
    width: 32px;
    height: 32px;
  }

  .experience-text-group {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .experience-title {
    font-family: var(--font-title);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .experience-subtitle {
    font-family: var(--font-tech);
    font-size: 0.8rem;
    color: var(--accent-lime);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Botões de Ação lado a lado */
  .action-buttons-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background-color: var(--accent-lime);
    color: var(--text-dark);
    border: 1px solid var(--accent-lime);
    border-radius: var(--border-radius-sm);
    padding: 0.75rem 1.4rem;
    font-family: var(--font-tech);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn-primary-action:hover {
    background-color: #bbf451;
    border-color: #bbf451;
    transform: translateY(-1px);
  }

  .btn-secondary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background-color: var(--bg-cards);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    padding: 0.75rem 1.4rem;
    font-family: var(--font-tech);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .btn-secondary-action:hover {
    border-color: var(--accent-lime);
    color: var(--accent-lime);
    transform: translateY(-1px);
  }

  /* ==========================================================================
     2. Seção "Stack Tecnológica"
     ========================================================================== */
  .section-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .stack-header {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .stack-intro-text {
    font-family: var(--font-tech);
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Grade 2x2 no Desktop */
  .tech-grid-2x2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    width: 100%;
  }

  .tech-card-box {
    background-color: var(--bg-cards);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: none;
  }

  .tech-card-category {
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--accent-lime);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--border-color);
  }

  .tech-items-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .tech-item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .tech-info-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .tech-bullet-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-lime);
    flex-shrink: 0;
  }

  .tech-name {
    font-family: var(--font-tech);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  /* Classificação Visual por Estrelas (SVG) */
  .stars-rating-wrapper {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .star-svg {
    width: 15px;
    height: 15px;
  }

  .star-svg.filled {
    color: var(--accent-lime);
    fill: var(--accent-lime);
    stroke: var(--accent-lime);
  }

  .star-svg.empty {
    color: var(--text-secondary);
    fill: none;
    stroke: var(--text-secondary);
    opacity: 0.35;
  }

  /* ==========================================================================
     3. Botão GitHub
     ========================================================================== */
  .github-action-wrapper {
    margin-top: 0.75rem;
    width: 100%;
  }

  .btn-github-wide {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background-color: var(--bg-cards);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    padding: 1.15rem 1.5rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .btn-github-wide:hover {
    border-color: var(--accent-lime);
    transform: translateY(-1px);
  }

  .btn-github-wide:hover .github-label {
    color: var(--text-primary);
  }

  .btn-github-wide:hover .github-external-icon {
    transform: translate(2px, -2px);
  }

  .github-left-content {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .github-logo {
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .github-label {
    font-family: var(--font-tech);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .github-external-icon {
    color: var(--accent-lime);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  /* ==========================================================================
     4. Responsividade Mobile
     ========================================================================== */
  @media (max-width: 820px) {
    .sobre-container {
      gap: 2.75rem;
    }

    .section-title {
      font-size: 1.85rem;
    }

    .tech-grid-2x2 {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .action-buttons-group {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary-action,
    .btn-secondary-action {
      width: 100%;
    }

    .btn-github-wide {
      padding: 1rem 1.25rem;
    }

    .github-label {
      font-size: 0.825rem;
    }
  }
</style>
