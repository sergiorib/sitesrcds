---
import menuItems from '../config/menu.json';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Data Science Portfolio', description = 'Portfólio de Ciência de Dados e Inteligência Artificial' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Tipografia Tecnológica Sci-Fi (Orbitron e Rajdhani) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Importação da única fonte de verdade de cores e estilos Sci-Fi HUD -->
    <link rel="stylesheet" href="/assets/css/colors.css" />
    <link rel="stylesheet" href="/assets/css/style.css" />
  </head>
  <body>
    <!-- Cabeçalho fixo Sci-Fi / Cyberpunk HUD -->
    <header class="site-header">
      <div class="header-container">
        <!-- Identidade profissional à esquerda com anel tecnológico -->
        <a href="/" class="brand" aria-label="Página Inicial - Sergio Ribeiro">
          <div class="brand-avatar-wrapper">
            <img
              src="/assets/images/foto.jpg"
              alt="Foto do Perfil de Sergio Ribeiro"
              class="brand-avatar"
            />
          </div>
          <div class="brand-text">
            <span class="brand-name">Sergio Ribeiro</span>
            <span class="brand-role">Data Scientist</span>
          </div>
        </a>

        <!-- Botão retrátil mobile Sci-Fi -->
        <button class="mobile-toggle" aria-label="Abrir menu de navegação" aria-expanded="false">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>

        <!-- Menu de navegação à direita com botões geométricos neon -->
        <nav class="nav-menu">
          <ul class="nav-list">
            {
              menuItems.map((item) => {
                const isActive = (item.url === '/' && currentPath === '/') || (item.url !== '/' && currentPath === item.url);
                return (
                  <li class="nav-item">
                    <a
                      href={item.url}
                      class={`nav-link ${isActive ? 'active' : ''}`}
                    >
                      {item.title}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <!-- Conteúdo principal -->
    <main class="main-content">
      <slot />
    </main>

    <!-- Script de interatividade client-side puro -->
    <script src="/assets/js/app.js" is:inline></script>
  </body>
</html>
